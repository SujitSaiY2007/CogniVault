# Copy to .env locally. Never commit .env.
# Local execution (Default - zero paid API):
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
CHROMA_PERSIST_DIR=data/chroma
AGENTOS_HOST=0.0.0.0
AGENTOS_PORT=8000

# Optional external LLM fallback (not required):
GEMINI_API_KEY=
MODEL_NAME=gemini-1.5-flash

# Operational limits:
APP_ENV=development
MAX_REQUESTS_PER_SESSION=50
MAX_INGESTION_MB=25
MAX_ASSESSMENT_GENERATIONS=20

