# Copy to .env (never commit .env). Every setting is optional.

# Answer engine. "auto" = Gemini if GEMINI_API_KEY is set, else Ollama if reachable,
# else the built-in extractive engine (no model, no cost).
MODEL_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Embeddings: hashing (default, no download) | gemini | sentence-transformers
EMBEDDING_PROVIDER=hashing

# Durable storage for accounts, uploads and progress (recommended on free hosts
# whose disk is wiped on restart). Server-side only: never expose this key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated frontend origins allowed by CORS (empty = any origin, no cookies)
CORS_ORIGINS=

# Local storage location and limits
CV_DATA_DIR=data
SEED_DEMO_COURSE=1
MAX_UPLOAD_MB=25
MAX_FILES_PER_ACCOUNT=20
MAX_ACCOUNT_MB=150
